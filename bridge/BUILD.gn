import("//third_party/jni_zero/jni_zero.gni")

generate_jni("jni_headers") {
  sources = [ "java/src/io/dioide/aerium/bridge/ExtensionsImpl.java" ]
}

source_set("native") {
  sources = [ "native/extensions_bridge.cc" ]
  deps = [
    ":jni_headers",
    "//base",
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/toolbar",
    "//extensions/browser",
    "//extensions/common",
    "//url",
  ]
}
