+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
@@ -35,6 +35,7 @@ import org.chromium.components.ukm.UkmRecorder;
 import org.chromium.content_public.browser.LifecycleState;
 import org.chromium.content_public.browser.RenderFrameHost;
 import org.chromium.content_public.browser.Visibility;
+import org.chromium.components.webauthn.cred_man.CredManSupportProvider;
 import org.chromium.content_public.browser.WebContents;
 import org.chromium.mojo.system.MojoException;
 import org.chromium.ui.base.WindowAndroid;
@@ -189,7 +190,7 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
                                     .build()));
             return;
         }
-        if (!GmsCoreUtils.isWebauthnSupported()
+        if (!hasWebauthnBackend()
                 || (!isChrome(mWebContents) && !GmsCoreUtils.isResultReceiverSupported())) {
             mRequestCallback.onComplete(
                     WebauthnRequestResponse.forFailedMakeCredential(
@@ -291,7 +292,7 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
                 options.publicKey == null
                         && options.password
                         && options.mediation == Mediation.IMMEDIATE;
-        if (!GmsCoreUtils.isWebauthnSupported()
+        if (!hasWebauthnBackend()
                 || (!isChrome(mWebContents) && !GmsCoreUtils.isResultReceiverSupported())
                 || (options.publicKey == null && !isPasswordOnlyFlux)) {
             RequestMetrics metrics =
@@ -336,12 +337,18 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
         mPendingFido2CredentialRequest.handleReportRequest(options, assertNonNull(mOrigin));
     }
 
+    private static boolean hasWebauthnBackend() {
+        return GmsCoreUtils.isWebauthnSupported()
+                || CredManSupportProvider.getCredManSupport()
+                        == CredManSupport.FULL_UNLESS_INAPPLICABLE;
+    }
+
     private boolean couldSupportConditionalMediation() {
-        return GmsCoreUtils.isWebauthnSupported() && isChrome(mWebContents);
+        return hasWebauthnBackend() && isChrome(mWebContents);
     }
 
     private boolean couldSupportUvpaa() {
-        return GmsCoreUtils.isWebauthnSupported()
+        return hasWebauthnBackend()
                 && (isChrome(mWebContents) || GmsCoreUtils.isResultReceiverSupported());
     }
 
diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/Fido2CredentialRequest.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/Fido2CredentialRequest.java
