--- /dev/null
+++ b/chrome/browser/ui/android/omnibox/java/src/org/chromium/chrome/browser/omnibox/LinkCleaner.java
@@ -0,0 +1,28 @@
+// Copyright 2026 Dioide
+// SPDX-License-Identifier: GPL-3.0-only
+
+package org.chromium.chrome.browser.omnibox;
+
+import org.chromium.base.ServiceLoaderUtil;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+@NullMarked
+public final class LinkCleaner {
+    public interface Cleaner {
+        String clean(String url);
+    }
+
+    private static boolean sLoaded;
+    private static @Nullable Cleaner sCleaner;
+
+    private LinkCleaner() {}
+
+    public static String clean(String url) {
+        if (!sLoaded) {
+            sLoaded = true;
+            sCleaner = ServiceLoaderUtil.maybeCreate(Cleaner.class);
+        }
+        return sCleaner == null ? url : sCleaner.clean(url);
+    }
+}
