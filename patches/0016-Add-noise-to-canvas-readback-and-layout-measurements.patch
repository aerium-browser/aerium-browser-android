+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "ui/gfx/geometry/quad_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace blink {
+
+class PLATFORM_EXPORT FingerprintNoise {
+  STATIC_ONLY(FingerprintNoise);
+
+ public:
+  static bool IsEnabled();
+  static void AddToPixels(const SkPixmap& pixmap, int origin_x, int origin_y);
+  static SkPixmap ForEncoding(const SkPixmap& pixmap, Vector<uint8_t>& storage);
+  static double Scale(double value);
+  static gfx::RectF Scale(const gfx::RectF& rect);
+  static gfx::QuadF Scale(const gfx::QuadF& quad);
+};
+
+}  // namespace blink
