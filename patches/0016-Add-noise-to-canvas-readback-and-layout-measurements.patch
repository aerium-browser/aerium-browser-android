diff --git a/third_party/blink/renderer/platform/graphics/fingerprint_noise.cc b/third_party/blink/renderer/platform/graphics/fingerprint_noise.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a32032a12d118ce0c30a2f00b4afd4f4f250b2a5
--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/fingerprint_noise.cc
@@ -0,0 +1,107 @@
+// Copyright 2026 Dioide
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "third_party/blink/renderer/platform/graphics/fingerprint_noise.h"
+
+#include "base/containers/span.h"
+#include "base/feature_list.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/rand_util.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink {
+
+namespace {
+
+BASE_FEATURE(kAeriumFingerprintNoise, base::FEATURE_ENABLED_BY_DEFAULT);
+
+uint64_t Mix(uint64_t value) {
+  value += 0x9e3779b97f4a7c15ull;
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ull;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebull;
+  return value ^ (value >> 31);
+}
+
+uint64_t SessionKey() {
+  static const uint64_t key = base::RandUint64();
+  return key;
+}
+
+double Factor() {
+  static const double factor =
+      1.0 + (static_cast<double>(Mix(SessionKey()) % 2001) - 1000.0) * 1e-7;
+  return factor;
+}
+
+bool HasByteChannels(const SkPixmap& pixmap) {
+  return pixmap.addr() && (pixmap.colorType() == kRGBA_8888_SkColorType ||
+                           pixmap.colorType() == kBGRA_8888_SkColorType);
+}
+
+}  // namespace
+
+bool FingerprintNoise::IsEnabled() {
+  return base::FeatureList::IsEnabled(kAeriumFingerprintNoise);
+}
+
+void FingerprintNoise::AddToPixels(const SkPixmap& pixmap,
+                                   int origin_x,
+                                   int origin_y) {
+  if (!IsEnabled() || !HasByteChannels(pixmap)) {
+    return;
+  }
+  base::span<uint8_t> bytes = gfx::SkPixmapToWritableSpan(pixmap);
+  const size_t row_bytes = pixmap.rowBytes();
+  const uint64_t key = SessionKey();
+  for (int y = 0; y < pixmap.height(); ++y) {
+    for (int x = 0; x < pixmap.width(); ++x) {
+      const size_t offset =
+          static_cast<size_t>(y) * row_bytes + static_cast<size_t>(x) * 4;
+      if (bytes[offset + 3] != 0xff) {
+        continue;
+      }
+      const uint64_t position =
+          (static_cast<uint64_t>(static_cast<uint32_t>(origin_y + y)) << 32) |
+          static_cast<uint32_t>(origin_x + x);
+      const uint64_t hash = Mix(key ^ position);
+      if ((hash & 31) != 0) {
+        continue;
+      }
+      bytes[offset + (hash >> 5) % 3] ^= 1;
+    }
+  }
+}
+
+SkPixmap FingerprintNoise::ForEncoding(const SkPixmap& pixmap,
+                                       Vector<uint8_t>& storage) {
+  if (!IsEnabled() || !HasByteChannels(pixmap)) {
+    return pixmap;
+  }
+  base::span<const uint8_t> source = gfx::SkPixmapToSpan(pixmap);
+  storage.resize(base::checked_cast<wtf_size_t>(source.size()));
+  base::span(storage).copy_from(source);
+  SkPixmap copy(pixmap.info(), storage.data(), pixmap.rowBytes());
+  AddToPixels(copy, 0, 0);
+  return copy;
+}
+
+double FingerprintNoise::Scale(double value) {
+  return IsEnabled() ? value * Factor() : value;
+}
+
+gfx::RectF FingerprintNoise::Scale(const gfx::RectF& rect) {
+  if (!IsEnabled()) {
+    return rect;
+  }
+  return gfx::ScaleRect(rect, static_cast<float>(Factor()));
+}
+
+gfx::QuadF FingerprintNoise::Scale(const gfx::QuadF& quad) {
+  gfx::QuadF scaled = quad;
+  if (IsEnabled()) {
+    scaled.Scale(static_cast<float>(Factor()));
+  }
+  return scaled;
+}
+
+}  // namespace blink
