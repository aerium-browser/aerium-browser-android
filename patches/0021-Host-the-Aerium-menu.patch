diff --git a/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuHandlerImpl.java b/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuHandlerImpl.java
index 9a1cbc7f512c4a204f6e836fba1abfc55b0f04f4..00a08c0789ea6d059ebf2942acc10ab0546653d9 100644
--- a/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuHandlerImpl.java
+++ b/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuHandlerImpl.java
@@ -118,6 +118,29 @@ class AppMenuHandlerImpl
     private final WindowAndroid mWindowAndroid;
     private final BrowserControlsStateProvider mBrowserControlsStateProvider;
     private @Nullable ModelList mModelList;
+    private AppMenuSheet.@Nullable Session mSheetSession;
+    private final AppMenuSheet.Host mSheetHost =
+            new AppMenuSheet.Host() {
+                @Override
+                public void select(int id) {
+                    PropertyModel model = mModelList == null ? null : findItem(mModelList, id);
+                    if (model != null
+                            && model.containsKey(AppMenuItemProperties.ENABLED)
+                            && !model.get(AppMenuItemProperties.ENABLED)) {
+                        return;
+                    }
+                    mAppMenuDelegate.onOptionsItemSelected(
+                            id, model == null ? null : mDelegate.getBundleForMenuItem(model), null);
+                }
+
+                @Override
+                public void dismissed() {
+                    mSheetSession = null;
+                    mDelegate.onMenuDismissed();
+                    if (mModelList != null) mModelList.removeObserver(mListObserver);
+                    onMenuVisibilityChanged(false);
+                }
+            };
     private @Nullable HierarchicalMenuController<AppMenuPopup> mHierarchicalMenuController;
     private final SubmenuHeaderFactory mSubmenuHeaderFactory;
     private final ListObserver<Void> mListObserver;
@@ -338,6 +361,16 @@ class AppMenuHandlerImpl
 
         mModelList = mDelegate.getMenuItems();
         mModelList.addObserver(mListObserver);
+        AppMenuSheet.Presenter sheetPresenter = AppMenuSheet.getPresenter();
+        AppMenuSheet.@Nullable Session sheetSession =
+                sheetPresenter == null
+                        ? null
+                        : sheetPresenter.show(mContext, mModelList, mSheetHost);
+        if (sheetSession != null) {
+            mSheetSession = sheetSession;
+            onMenuVisibilityChanged(true);
+            return true;
+        }
         ContextThemeWrapper wrapper =
                 new ContextThemeWrapper(mContext, R.style.AppMenuThemeOverlay);
 
@@ -455,9 +488,26 @@ class AppMenuHandlerImpl
         }
     }
 
+    private static @Nullable PropertyModel findItem(ModelList list, int id) {
+        for (int i = 0; i < list.size(); i++) {
+            PropertyModel model = list.get(i).model;
+            if (model.containsKey(AppMenuItemProperties.MENU_ITEM_ID)
+                    && model.get(AppMenuItemProperties.MENU_ITEM_ID) == id) {
+                return model;
+            }
+            if (!model.containsKey(AppMenuItemProperties.ADDITIONAL_ICONS)) continue;
+            ModelList icons = model.get(AppMenuItemProperties.ADDITIONAL_ICONS);
+            if (icons == null) continue;
+            PropertyModel inner = findItem(icons, id);
+            if (inner != null) return inner;
+        }
+        return null;
+    }
+
     @Override
     public boolean isAppMenuShowing() {
-        return mAppMenu != null && mAppMenu.isShowing();
+        return (mSheetSession != null && mSheetSession.isShowing())
+                || (mAppMenu != null && mAppMenu.isShowing());
     }
 
     /**
@@ -473,6 +523,7 @@ class AppMenuHandlerImpl
 
     @Override
     public void hideAppMenu() {
+        if (mSheetSession != null) mSheetSession.dismiss();
         if (mAppMenu != null && mAppMenu.isShowing()) {
             mAppMenu.dismiss();
         }
